# agent-payments — example environment
#
# The reference implementation needs NO secrets: the demo, the unit tests and the offline
# verifier all run with an empty environment. This file documents the optional variables a
# real deployment may set.
#
#     cp .env.example .env        and fill only what you need.
#
# NEVER commit a real .env. It is ignored by .gitignore.

# ── The console's port ──────────────────────────────────────────────────────
# The platform sets this; locally it defaults to 8477.
# PORT=8477

# ── Issuer ──────────────────────────────────────────────────────────────────
# The reference implementation derives an ephemeral Ed25519 key (did:key) per session and
# never persists it; the public did:key travels inside the bundle. Set this ONLY if you run
# your own issuer and want the key to be stable across restarts. PEM, PKCS#8, Ed25519.
# ISSUER_PRIVATE_KEY_PEM=

# ── Payment processor (optional) ────────────────────────────────────────────
# Only if you wire a PSP for settlement. The evidence layer never needs it: the proof is
# produced BEFORE settlement and is verified independently of it.
# PSP_API_KEY=
# PSP_WEBHOOK_SECRET=
